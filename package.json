{
  "name": "security-platform",
  "version": "0.1.1",
  "description": "Centralized, reusable AI-agent-driven security assessment platform (CLI + MCP + orchestrator + skills)",
  "bin": {
    "security": "dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "dist/install",
    "dist/src",
    "skills",
    "templates",
    "docker/docker-compose.yml",
    "docker/.env.example",
    "scripts",
    "install.bat",
    "install.sh",
    "!dist/src/test"
  ],
  "type": "commonjs",
  "license": "MIT",
  "keywords": [
    "security",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "pentest",
    "sast",
    "dast",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
